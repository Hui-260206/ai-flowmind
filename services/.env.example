# 复制为 services/.env，用于 macOS 本地原生开发。不要提交 services/.env。
# MySQL 和 Redis 预期直接安装并运行在这台 Mac 上。

# Go API
GO_ENV=local
GO_HTTP_ADDR=:8080
GO_LOG_LEVEL=info
GO_SHUTDOWN_TIMEOUT=10s
GO_READ_HEADER_TIMEOUT=5s
GO_READ_TIMEOUT=15s
GO_WRITE_TIMEOUT=15s
GO_IDLE_TIMEOUT=60s

# Python AI 服务（仅 gRPC；阶段 1.8 无 HTTP 入口）
AI_ENV=local
AI_LOG_LEVEL=info
AI_GRPC_LISTEN_ADDR=127.0.0.1:50051

# Provider 配置。真实密钥只放入 AI 服务的部署环境。
AI_PROVIDER=fake
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
MODEL_PROFILE=default

# Go API -> AI gRPC 客户端（阶段 1.10 由 go-api 使用）
AI_GRPC_ADDR=127.0.0.1:50051
AI_GRPC_TIMEOUT=15s

# macOS 原生模式：MySQL 和 Redis 监听本机回环接口。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=flowmind_dev
MYSQL_USER=flowmind_app
MYSQL_PASSWORD=change-me-in-local-env
MYSQL_ROOT_PASSWORD=change-me-root-in-local-env
MYSQL_TIMEZONE=Asia/Shanghai
MYSQL_TIMEZONE_OFFSET=+08:00
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=10m

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=change-me-in-local-env
