# Copy to services/.env for local native development on macOS. Do not commit services/.env.
# MySQL and Redis are expected to be installed and running directly on this Mac.

# Go API
GO_ENV=local
GO_HTTP_ADDR=:8080
GO_LOG_LEVEL=info
GO_SHUTDOWN_TIMEOUT=10s
GO_READ_HEADER_TIMEOUT=5s
GO_READ_TIMEOUT=15s
GO_WRITE_TIMEOUT=15s
GO_IDLE_TIMEOUT=60s

# AI service endpoints
AI_HTTP_ADDR=:8000
AI_GRPC_ADDR=ai-service:50051
AI_GRPC_TIMEOUT=15s
MODEL_PROFILE=default

# Native macOS mode: MySQL and Redis listen on the local loopback interface.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=flowmind_dev
MYSQL_USER=flowmind_app
MYSQL_PASSWORD=change-me-in-local-env
MYSQL_ROOT_PASSWORD=change-me-root-in-local-env
MYSQL_TIMEZONE=Asia/Shanghai
MYSQL_TIMEZONE_OFFSET=+08:00
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=10m

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=change-me-in-local-env

# Python AI provider settings. Keep real keys only in the AI service deployment.
AI_PROVIDER=fake
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
