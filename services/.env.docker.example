# 后续部署模板，仅与 docker-compose.yaml 配合使用。
# 不要提交真实的部署 .env 文件或任何真实凭据。

GO_ENV=production
GO_HTTP_PORT=8080
GO_LOG_LEVEL=info
GO_SHUTDOWN_TIMEOUT=10s
GO_READ_HEADER_TIMEOUT=5s
GO_READ_TIMEOUT=15s
GO_WRITE_TIMEOUT=15s
GO_IDLE_TIMEOUT=60s

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=flowmind_dev
MYSQL_USER=flowmind_app
MYSQL_PASSWORD=change-me-in-deployment-env
MYSQL_ROOT_PASSWORD=change-me-root-in-deployment-env
MYSQL_TIMEZONE=Asia/Shanghai
MYSQL_TIMEZONE_OFFSET=+08:00
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=10m

REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_PASSWORD=change-me-in-deployment-env
REDIS_IDEMPOTENCY_TTL=48h
REDIS_SESSION_LOCK_TTL=30s
REDIS_OWNER_RATE_LIMIT_PER_MINUTE=20

# AI 服务（Python，仅 gRPC）。在 compose 网络内监听，不对外暴露。
AI_ENV=production
AI_LOG_LEVEL=info
AI_GRPC_LISTEN_ADDR=0.0.0.0:50051

# Go API -> AI gRPC 客户端
AI_GRPC_ADDR=ai-service:50051
AI_GRPC_TIMEOUT=14s
AI_GRPC_KEEPALIVE_TIME=30s
AI_GRPC_KEEPALIVE_TIMEOUT=10s
AI_GRPC_MAX_MESSAGE_BYTES=1048576
MODEL_PROFILE=default

# Provider 配置。真实密钥只放入 AI 服务的部署环境。
AI_PROVIDER=fake
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=hy3
AI_PROVIDER_TIMEOUT=12
